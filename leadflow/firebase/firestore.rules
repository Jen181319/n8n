rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Baileys credentials: server only
    match /waAuth/{doc=**} { allow read, write: if false; }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Everything under the user's own tree except wa/, which only the worker (admin SDK) may write.
      // (Rules are OR-ed, so wa must be excluded here rather than denied separately.)
      match /{coll}/{path=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && coll != 'wa';
      }
    }
  }
}
